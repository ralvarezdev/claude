{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/context-checkpoint.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/guard-deep-fork.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/guard-transcript-reads.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/context-meter.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/guard-model-switch.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/guard-subagent-report.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/loop-concision.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/cache-watch.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
